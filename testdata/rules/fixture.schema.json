{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "mode",
    "source",
    "initial",
    "commands",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "mcr",
        "riichi"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "initial": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
